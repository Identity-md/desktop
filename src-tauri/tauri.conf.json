{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IMD Agents",
  "version": "0.1.14",
  "identifier": "fun.imd.agents",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "title": "IMD Agents",
        "width": 404,
        "height": 518,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://api.imd.fun https://media.imd-cdn.xyz; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "IMD",
    "shortDescription": "Every IMD agent you hold, from the menu bar or the taskbar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installerIcon": "icons/icon.ico" }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": { "Resources/Assets.car": "icons/Assets.car" },
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzREM5RkM4QjMyNkQ1MDAKUldRQTFTYXp5Si9jODBZVHd4Q3BLeSt1SE51UE1ZL1RhcXBWQWY3c0cyZHBLYk1sMjhJb1k1Q3MK",
      "endpoints": ["https://github.com/Identity-md/desktop/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  }
}
